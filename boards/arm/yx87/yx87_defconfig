CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_YX87=y

CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y

# Matrix columns 7-14 live on a PCF8574 I2C GPIO expander
CONFIG_I2C=y

# UART RX would claim P0.08 (WS2812 data) - keep serial off
CONFIG_SERIAL=n

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y

# ---- PURE USB KEYBOARD BRINGUP (all extras disabled) ----
CONFIG_ZMK_BLE=n
CONFIG_BT=n
CONFIG_SETTINGS=n
CONFIG_NVS=n
CONFIG_ZMK_RGB_UNDERGLOW=n
CONFIG_ZMK_BATTERY_REPORTING=n
CONFIG_ZMK_HID_INDICATORS=n

# RTT debug logging
CONFIG_USE_SEGGER_RTT=y
CONFIG_LOG_BACKEND_RTT=y
CONFIG_LOG_BACKEND_RTT_MODE_DROP=y
CONFIG_LOG_DEFAULT_LEVEL=3

# USB HID must be enabled for a pure-USB keyboard (was dropped with ZMK_BLE=n)
CONFIG_ZMK_USB=y

# ---- DIAG LED (bringup-diag-led): light T80 WS2812 on boot ----
CONFIG_LED_STRIP=y
CONFIG_WS2812_STRIP=y
