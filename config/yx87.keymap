/*
 * yx87 minimal keymap
 * 6 rows x 15 columns, 81 keys + 9 empty positions
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp ESC   &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp PRTSCkp PRINTSCREEN &kp SCLK
    &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp INS
    &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH  &kp DEL
    &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp QUOTE kp SINGLE_QUOTE &kp RETURN &kp PAUSE kp PAUSE_BREAK &none
    &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP    &none     &none
    &kp LCTRL &kp LGUI  &kp LALT  &kp SPACE &kp RALT  &kp RCTRL &none     &none     &none     &none     &none     &none     &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };
    };
};
